#include <behaviors.dtsi>
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>

#define BASE 0
#define MACOS 1
#define LOWER 2
#define RAISE 3
#define RAISE_MACOS 4
#define ADJUST 5
#define GAMING 6

&gresc {
    bindings = <&kp ESC>, <&kp CAPSLOCK>;
};

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE COMMA DOT SEMICOLON COLON GREATER_THAN LESS_THAN>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };

        raise_macos {
            if-layers = <MACOS RAISE>;
            then-layer = <RAISE_MACOS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bspc {
            timeout-ms = <20>;
            key-positions = <19 20>;
            bindings = <&kp BSPC>;
        };

        combo_alt_bspc {
            timeout-ms = <20>;
            key-positions = <18 19>;
            bindings = <&kp LA(BSPC)>;
        };

        combo_del {
            timeout-ms = <20>;
            key-positions = <15 16>;
            bindings = <&kp DELETE>;
        };

        em_email {
            bindings = <&email_dvorak>;
            key-positions = <31 15>;
            layers = <LOWER>;
        };
    };

    macros {
        email_dvorak: email_dvorak {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp P &kp S &kp K &kp L &kp G &kp V &kp S &kp DOT &kp A &kp L &kp K &kp S &kp L &kp AT &kp U &kp M &kp A &kp G &kp P &kp E &kp I &kp S &kp M>;
            label = "EMAIL_DVORAK";
            tap-ms = <3>;
        };
    };

    behaviors {
        mod_2_1: mod_2_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "MOD_2_1";
            #binding-cells = <0>;
            tapping-term-ms = <20>;
            bindings = <&mo RAISE>, <&mo LOWER>;
        };

        mod2_f18: mod2_f18 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Ctrl+Shift+Cmd+7 is caught by Hammerspoon (nixos-config-flake, hammerspoon/wm.nix).
        mac_pscr: mac_pscr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LG(NUMBER_4)))>, <&kp LC(LS(LG(NUMBER_7)))>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        msc {
            acceleration-exponent = <1>;
            time-to-max-speed-ms = <400>;
            delay-ms = <0>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            label = "base";
            bindings = <
&kp TAB        &kp Q           &kp W            &kp E               &kp R                       &kp T        &kp Y      &kp U        &kp I        &kp O        &kp P          &kp LBKT
&gresc         &hm LEFT_ALT A  &hm LEFT_META S  &hm LEFT_CONTROL D  &hm LEFT_SHIFT F            &kp G        &kp H      &hm RSHFT J  &hm RCTRL K  &hm RMETA L  &hm RALT SEMI  &kp SQT
&kp BACKSLASH  &kp Z           &kp X            &kp C               &kp V                       &kp B        &kp N      &kp M        &kp COMMA    &kp DOT      &kp FSLH       &kp RIGHT_BRACKET
                                                &kp LA(LC(LGUI))            &mo LOWER           &kp SPACE    &kp ENTER  &mod_2_1     &mod2_f18 LGUI F18
            >;
        };

        macos {
            label = "mac";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &mod2_f18 LC(LGUI) F18
            >;
        };

        lower {
            label = "symbol";
            bindings = <
&kp GRAVE   &kp N1    &kp N2  &kp N3     &kp N4     &kp N5                  &kp N6                 &kp N7         &kp N8         &kp N9    &kp N0    &trans
&caps_word  &kp EXCL  &kp AT  &kp HASH   &kp DLLR   &kp PRCNT               &kp CARET              &kp AMPS       &kp ASTERISK   &kp LPAR  &kp RPAR  &kp PIPE
&trans      &trans    &trans  &kp MINUS  &kp EQUAL  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp LS(MINUS)  &kp LS(EQUAL)  &trans    &trans    &trans
                              &trans     &trans     &trans                  &trans                 &kp CAPSLOCK   &trans
            >;
        };

        raise {
            label = "media";
            bindings = <
&trans  &kp INS     &kp PRINTSCREEN  &kp K_CMENU  &kp C_VOL_DN  &kp C_VOL_UP    &kp PG_UP  &kp HOME          &kp UP      &kp END     &kp N0             &kp RBKT
&trans  &trans      &trans           &trans       &caps_word    &trans          &kp PG_DN  &kp LEFT          &kp DOWN    &kp RIGHT   &kp BSPC           &kp DEL
&trans  &kp K_UNDO  &kp K_CUT        &kp K_COPY   &kp K_PASTE   &kp C_MUTE      &trans     &kp K_PLAY_PAUSE  &kp K_PREV  &kp K_NEXT  &kp LC(BACKSPACE)  &kp LC(DELETE)
                                     &trans       &trans        &trans          &trans     &trans            &trans
            >;
        };

        raise_macos {
            label = "media mac";
            bindings = <
&trans  &trans  &mac_pscr  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans             &trans
&trans  &trans  &trans     &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans             &trans
&trans  &trans  &trans     &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp LA(BACKSPACE)  &kp LA(DELETE)
                           &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        adjust {
            label = "config";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &kp C_BRI_DN  &kp C_BRI_UP  &none   &none   &none    &none
&kp F12     &kp F1        &kp F2        &kp F3          &kp F4        &kp F5          &kp F6        &kp F7        &kp F8  &kp F9  &kp F10  &kp F11
&df DF_INC  &tog GAMING   &none         &none           &none         &bootloader     &bootloader   &none         &none   &none   &none    &none
                                        &msc SCRL_DOWN  &none         &msc SCRL_UP    &none         &none         &none
            >;
        };

        gaming {
            label = "GAME";
            bindings = <
&trans          &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &trans
&trans          &kp A   &kp S   &kp D   &kp F   &trans    &trans  &kp J   &kp K   &kp L   &kp SEMI  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &trans
                                &kp LEFT_CONTROL  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
